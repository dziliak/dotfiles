#!/bin/bash
# AeroSpace workspaces and system status. Managed with chezmoi; see README.md.

CONFIG_DIR="${CONFIG_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export CONFIG_DIR
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/settings.sh"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar

bar=(
  position=top
  height=28
  blur_radius=60
  margin=5
  corner_radius=10
  y_offset=2
  color="$COLOR_BAR"
  border_color="$COLOR_DARK"
  border_width=2
)

sketchybar --bar "${bar[@]}"

##### Changing Defaults #####
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="$FONT_ICON"
  label.font="$FONT_LABEL"
  icon.color="$COLOR_TEXT"
  label.color="$COLOR_TEXT"
  icon.padding_left=4
  icon.padding_right=4
  icon.y_offset=0
  label.padding_left=4
  label.padding_right=4
  label.y_offset=0
)
sketchybar --default "${default[@]}"

##### Spotlight shortcut #####

sketchybar --add item apple left \
  --set apple \
    padding_left=-7 \
    icon=  \
    icon.font="$FONT_FAMILY:Regular:22.0" \
    label.drawing=off \
    icon.y_offset=1 \
    click_script="osascript -e 'tell application \"System Events\" to keystroke \" \" using {command down}'"

##### AeroSpace Workspaces #####

sketchybar --add event aerospace_workspace_change

for ws in "${WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
      icon="$ws" \
      icon.drawing=on \
      icon.padding_left=7 \
      icon.padding_right=7 \
      icon.font="$FONT_LABEL" \
      icon.y_offset=0 \
      label.drawing=off \
      drawing=on \
      background.drawing=off \
      background.corner_radius=6 \
      background.height=18 \
      click_script="aerospace workspace $ws"
done

sketchybar --add item aerospace_watcher left \
  --set aerospace_watcher \
    drawing=off \
    updates=on \
    update_freq="$WORKSPACE_INTERVAL" \
    script="$PLUGIN_DIR/aerospace_workspace.sh" \
  --subscribe aerospace_watcher aerospace_workspace_change space_windows_change system_woke display_change

##### Adding Left Items #####

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off label.max_chars=24 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding Right Items #####
# The clock includes seconds. CPU/network sample every three seconds by default.
# Volume and workspaces use events plus a slow fallback for missed notifications.
# https://felixkratz.github.io/SketchyBar/config/events

##### Calendar Dropdown #####

sketchybar --add item calendar right \
  --set calendar \
    icon="󰃭" \
    label="$(date '+%a %b %d')" \
    update_freq=60 \
    script="$PLUGIN_DIR/calendar.sh" \
    click_script="$PLUGIN_DIR/calendar.sh toggle" \
    popup.drawing=off \
    popup.align=right \
    popup.height=26 \
    popup.y_offset=8 \
    popup.background.drawing=on \
    popup.background.color="$COLOR_POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$COLOR_TEXT" \
  --subscribe calendar system_woke

##### Calendar Popup Rows #####

# Month title
sketchybar --add item calendar.month popup.calendar \
  --set calendar.month \
    icon.drawing=off \
    label="$(date '+%B %Y')" \
    label.align=center \
    label.font="$FONT_TITLE" \
    width=180 \
    background.drawing=off

# Weekday header + up to 6 weeks
for i in 0 1 2 3 4 5 6; do
  sketchybar --add item calendar.row.$i popup.calendar \
    --set calendar.row.$i \
      icon.drawing=off \
      label.font="$FONT_SMALL" \
      label.align=center \
      width=180 \
      background.drawing=off
done

sketchybar --add item clock right \
  --set clock \
    update_freq=1 \
    icon= \
    label.width=76 \
    label.align=right \
    script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock system_woke

sketchybar --add item volume right \
  --set volume \
    drawing=on \
    icon.drawing=on \
    label.drawing=on \
    label.width=40 \
    label.align=right \
    update_freq="$VOLUME_INTERVAL" \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change mouse.scrolled system_woke

sketchybar --add item battery right \
  --set battery \
    update_freq=120 \
    label.width=40 \
    label.align=right \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item cpu right \
  --set cpu \
    update_freq="$CPU_INTERVAL" \
    icon= \
    label.width=40 \
    label.align=right \
    script="$PLUGIN_DIR/cpu.sh" \
  --subscribe cpu system_woke

sketchybar --add item network right \
  --set network \
    icon.width=20 \
    icon.align=center \
    icon.font="$FONT_LABEL" \
    label.width=230 \
    label.align=right \
    update_freq="$NETWORK_INTERVAL" \
    icon=󰛳 \
    script="$PLUGIN_DIR/network.sh" \
  --subscribe network system_woke

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
