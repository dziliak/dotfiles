#!/bin/bash
# AeroSpace workspaces and system status. Managed with chezmoi; see README.md.

CONFIG_DIR="${CONFIG_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export CONFIG_DIR
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/settings.sh"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar

bar=(
  position=top
  height=28
  blur_radius=60
  margin=5
  corner_radius=10
  y_offset=2
  color="$COLOR_BAR"
  border_color="$COLOR_DARK"
  border_width=2
  # Above the menu bar level: since macOS 27.2 the auto-hidden menu bar keeps an
  # invisible full-width window at that level, which otherwise swallows all mouse events.
  topmost=on
)

sketchybar --bar "${bar[@]}"

##### Changing Defaults #####
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="$FONT_ICON"
  label.font="$FONT_LABEL"
  icon.color="$COLOR_TEXT"
  label.color="$COLOR_TEXT"
  icon.padding_left=4
  icon.padding_right=4
  icon.y_offset=0
  label.padding_left=4
  label.padding_right=4
  label.y_offset=0
)
sketchybar --default "${default[@]}"

##### Spotlight shortcut #####

sketchybar --add item apple left \
  --set apple \
  padding_left=-7 \
  icon= \
  icon.font="$FONT_FAMILY:Regular:22.0" \
  label.drawing=off \
  icon.y_offset=1 \
  click_script="osascript -e 'tell application \"System Events\" to keystroke \" \" using {command down}'"

##### AeroSpace Workspaces #####

sketchybar --add event aerospace_workspace_change

for ws in "${WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
    icon="$ws" \
    icon.drawing=on \
    icon.padding_left=7 \
    icon.padding_right=7 \
    icon.font="$FONT_LABEL" \
    icon.y_offset=0 \
    label.drawing=off \
    drawing=on \
    background.drawing=off \
    background.corner_radius=6 \
    background.height=18 \
    click_script="aerospace workspace $ws"
done

sketchybar --add item aerospace_watcher left \
  --set aerospace_watcher \
  drawing=off \
  updates=on \
  update_freq="$WORKSPACE_INTERVAL" \
  script="$PLUGIN_DIR/aerospace_workspace.sh" \
  --subscribe aerospace_watcher aerospace_workspace_change space_windows_change system_woke display_change

##### Adding Left Items #####

sketchybar --add item chevron left \
  --set chevron icon= label.drawing=off drawing=off \
  --add item front_app left \
  --set front_app drawing=off updates=on \
  update_freq="$WORKSPACE_INTERVAL" script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched aerospace_workspace_change space_windows_change system_woke display_change

##### Adding Right Items #####
# The clock includes seconds. CPU/memory/network sample every three seconds by default.
# Volume and workspaces use events plus a slow fallback for missed notifications.
# https://felixkratz.github.io/SketchyBar/config/events

##### Calendar Dropdown #####

sketchybar --add item calendar right \
  --set calendar \
  icon="󰃭" \
  label="$(date '+%a %b %d')" \
  update_freq=60 \
  script="$PLUGIN_DIR/calendar.sh" \
  click_script="$PLUGIN_DIR/calendar.sh toggle" \
  popup.drawing=off \
  popup.horizontal=on \
  popup.align=right \
  popup.height=26 \
  popup.y_offset=8 \
  popup.background.drawing=on \
  popup.background.color="$COLOR_POPUP" \
  popup.background.corner_radius=10 \
  popup.background.border_width=1 \
  popup.background.border_color="$COLOR_TEXT" \
  --subscribe calendar system_woke

##### Calendar Popup Rows #####

# Horizontal navigation header; the month hosts the grid directly below it.
sketchybar --add item calendar.previous popup.calendar \
  --set calendar.previous \
  icon.drawing=off \
  label="<" \
  label.font="$FONT_TITLE" \
  label.align=center \
  label.width=24 \
  label.padding_left=0 \
  label.padding_right=0 \
  width=24 \
  padding_right=0 \
  click_script="$PLUGIN_DIR/calendar.sh previous" \
  background.drawing=off

sketchybar --add item calendar.month popup.calendar \
  --set calendar.month \
  icon.drawing=off \
  label="$(date '+%B %Y')" \
  label.align=center \
  label.font="$FONT_TITLE" \
  label.width=160 \
  label.padding_left=0 \
  label.padding_right=0 \
  width=160 \
  padding_left=0 \
  padding_right=0 \
  popup.drawing=off \
  popup.align=center \
  popup.height=26 \
  popup.background.drawing=on \
  popup.background.color="$COLOR_POPUP" \
  popup.background.corner_radius=10 \
  popup.background.border_width=1 \
  popup.background.border_color="$COLOR_TEXT" \
  background.drawing=off

sketchybar --add item calendar.next popup.calendar \
  --set calendar.next \
  icon.drawing=off \
  label=">" \
  label.font="$FONT_TITLE" \
  label.align=center \
  label.width=24 \
  label.padding_left=0 \
  label.padding_right=0 \
  width=24 \
  padding_left=0 \
  click_script="$PLUGIN_DIR/calendar.sh next" \
  background.drawing=off

# Weekday header + up to 6 weeks
for i in 0 1 2 3 4 5 6; do
  sketchybar --add item calendar.row.$i popup.calendar.month \
    --set calendar.row.$i \
    icon.drawing=off \
    label.font="$FONT_SMALL" \
    label.align=left \
    label.padding_left=24 \
    label.padding_right=0 \
    width=208 \
    background.drawing=off
done

sketchybar --add item clock right \
  --set clock \
  update_freq=1 \
  icon= \
  label.width=76 \
  label.align=right \
  script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock system_woke

sketchybar --add item volume right \
  --set volume \
  drawing=on \
  icon.drawing=on \
  label.drawing=on \
  label.width=40 \
  label.align=right \
  update_freq="$VOLUME_INTERVAL" \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change mouse.scrolled system_woke

##### Sony WH-1000XM4 #####
# Battery in the bar while the headset is connected; click opens the settings popup and
# scrolling changes the system volume. The volume item is hidden meanwhile.
# Needs ~/.local/bin/xm4ctl (see github.com/dziliak/sketchy_sony_headphones) and XM4_MAC in settings.sh.

sketchybar --add item headphones right \
  --set headphones \
  drawing=off \
  icon="󰋋" \
  label.width=48 \
  label.align=right \
  update_freq=30 \
  script="$PLUGIN_DIR/headphones.sh" \
  click_script="$PLUGIN_DIR/headphones.sh toggle" \
  popup.drawing=off \
  popup.align=right \
  popup.height=26 \
  popup.y_offset=8 \
  popup.background.drawing=on \
  popup.background.color="$COLOR_POPUP" \
  popup.background.corner_radius=10 \
  popup.background.border_width=1 \
  popup.background.border_color="$COLOR_TEXT" \
  --subscribe headphones system_woke mouse.scrolled volume_change

# Popup rows: icon is the row label, label is the value (battery popup pattern).
hp_row=(
  icon.font="$FONT_SMALL" icon.width=110 icon.align=left icon.padding_left=12 icon.padding_right=8
  label.font="$FONT_SMALL" label.width=170 label.align=right label.padding_left=0 label.padding_right=12
  background.drawing=off
)
hp_slider=(
  icon.font="$FONT_SMALL" icon.width=110 icon.align=left icon.padding_left=12 icon.padding_right=8
  label.font="$FONT_SMALL" label.width=50 label.align=right label.padding_left=0 label.padding_right=12
  slider.width=120 slider.percentage=0 slider.highlight_color="$COLOR_CHARGING"
  slider.background.height=6 slider.background.corner_radius=3 slider.background.color="$COLOR_OCCUPIED"
  slider.knob="●" slider.knob.drawing=on slider.knob.font="$FONT_SMALL"
  background.drawing=off
)

for row in header sound mode ambient voice s2c dsee connection touch eq clearbass band.1 band.2 band.3 band.4 band.5 devices \
           device.0 device.1 device.2 device.3 device.4 device.5 device.6 device.7; do
  case "$row" in
    ambient | clearbass | band.*)
      sketchybar --add slider "headphones.$row" popup.headphones 120 --set "headphones.$row" "${hp_slider[@]}" label="--" ;;
    *)
      sketchybar --add item "headphones.$row" popup.headphones --set "headphones.$row" "${hp_row[@]}" label="--" ;;
  esac
done

sketchybar --set headphones.header icon="WH-1000XM4" icon.font="$FONT_TITLE" \
    updates=when_shown update_freq=60 script="$PLUGIN_DIR/headphones.sh refresh" \
  --set headphones.sound icon="Sound" icon.font="$FONT_TITLE" label="" \
  --set headphones.mode icon="Mode" click_script="$PLUGIN_DIR/headphones.sh mode" script="$PLUGIN_DIR/headphones.sh mode" \
  --subscribe headphones.mode mouse.scrolled \
  --set headphones.ambient icon="Ambient level" click_script="$PLUGIN_DIR/headphones.sh slider ambient" \
  --set headphones.voice icon="Focus on voice" click_script="$PLUGIN_DIR/headphones.sh toggle-key voice" \
  --set headphones.s2c icon="Speak-to-chat" click_script="$PLUGIN_DIR/headphones.sh toggle-key s2c" \
  --set headphones.dsee icon="DSEE Extreme" click_script="$PLUGIN_DIR/headphones.sh toggle-key dsee" \
  --set headphones.connection icon="Connection" click_script="$PLUGIN_DIR/headphones.sh toggle-key connection" \
  --set headphones.touch icon="Touch panel" click_script="$PLUGIN_DIR/headphones.sh toggle-key touch" \
  --set headphones.eq icon="Equalizer" icon.font="$FONT_TITLE" click_script="$PLUGIN_DIR/headphones.sh eq-menu" \
    popup.drawing=off popup.align=right popup.height=26 \
    popup.background.drawing=on popup.background.color="$COLOR_POPUP" popup.background.corner_radius=10 \
    popup.background.border_width=1 popup.background.border_color="$COLOR_TEXT" \
  --set headphones.clearbass icon="Clear Bass" click_script="$PLUGIN_DIR/headphones.sh slider clear-bass" \
  --set headphones.band.1 icon="400 Hz" click_script="$PLUGIN_DIR/headphones.sh slider eq-band 1" \
  --set headphones.band.2 icon="1 kHz" click_script="$PLUGIN_DIR/headphones.sh slider eq-band 2" \
  --set headphones.band.3 icon="2.5 kHz" click_script="$PLUGIN_DIR/headphones.sh slider eq-band 3" \
  --set headphones.band.4 icon="6.3 kHz" click_script="$PLUGIN_DIR/headphones.sh slider eq-band 4" \
  --set headphones.band.5 icon="16 kHz" click_script="$PLUGIN_DIR/headphones.sh slider eq-band 5" \
  --set headphones.devices icon="Devices" icon.font="$FONT_TITLE" label=""

for i in 0 1 2 3 4 5 6 7; do
  sketchybar --set "headphones.device.$i" drawing=off icon.width=200 label.width=80
done

# Equalizer preset list (nested popup); the plugin shows the ones the headset reports.
for id in $(seq 0 29); do
  sketchybar --add item "headphones.preset.$id" popup.headphones.eq \
    --set "headphones.preset.$id" drawing=off icon.drawing=off \
    label.font="$FONT_SMALL" label.align=left label.width=150 label.padding_left=12 label.padding_right=12 \
    click_script="$PLUGIN_DIR/headphones.sh preset $id" background.drawing=off
done

##### Battery #####

sketchybar --add item battery right \
  --set battery \
  update_freq=120 \
  label.width=40 \
  label.align=right \
  script="$PLUGIN_DIR/battery.sh" \
  popup.drawing=off \
  popup.align=right \
  popup.height=26 \
  popup.y_offset=8 \
  popup.background.drawing=on \
  popup.background.color="$COLOR_POPUP" \
  popup.background.corner_radius=10 \
  popup.background.border_width=1 \
  popup.background.border_color="$COLOR_TEXT" \
  --subscribe battery \
  system_woke \
  power_source_change \
  mouse.entered \
  mouse.exited \
  mouse.exited.global

# Battery popup rows
for row in power energy charge runtime to80 to100 current health cycles source; do
  sketchybar --add item "battery.$row" popup.battery \
    --set "battery.$row" \
    icon.font="$FONT_SMALL" \
    icon.width=80 \
    icon.align=left \
    icon.padding_left=12 \
    icon.padding_right=8 \
    label.font="$FONT_SMALL" \
    label.width=160 \
    label.align=left \
    label.padding_left=0 \
    label.padding_right=12 \
    background.drawing=off
done

# Labels shown on the left side of each popup row
sketchybar --set battery.power icon="Power" label="--"
sketchybar --set battery.energy icon="Energy" label="--"
sketchybar --set battery.charge icon="Charge" label="--"
sketchybar --set battery.runtime icon="Runtime" label="--"
sketchybar --set battery.to80 icon="To 80%" label="--"
sketchybar --set battery.to100 icon="To 100%" label="--"
sketchybar --set battery.current icon="Current" label="--"
sketchybar --set battery.health icon="Health" label="--"
sketchybar --set battery.cycles icon="Cycles" label="--"
sketchybar --set battery.source icon="Source" label="--"

# Use one popup row as the controller for live popup updates.
# battery_popup.py updates all of the popup rows.
sketchybar --set battery.power \
  script="$PLUGIN_DIR/battery_popup.py" \
  update_freq=2 \
  updates=when_shown

##### CPU #####

sketchybar --add item cpu right \
  --set cpu \
  update_freq="$CPU_INTERVAL" \
  icon= \
  label.width=40 \
  label.align=right \
  script="$PLUGIN_DIR/cpu.sh" \
  click_script="$PLUGIN_DIR/cpu.sh click" \
  --subscribe cpu system_woke

##### Memory #####

sketchybar --add item memory right \
  --set memory \
  update_freq="$MEMORY_INTERVAL" \
  icon= \
  label.width=180 \
  label.align=right \
  script="$PLUGIN_DIR/memory.sh" \
  click_script="open -a 'Activity Monitor'" \
  popup.drawing=off \
  popup.align=right \
  popup.height=26 \
  popup.y_offset=8 \
  popup.background.drawing=on \
  popup.background.color="$COLOR_POPUP" \
  popup.background.corner_radius=10 \
  popup.background.border_width=1 \
  popup.background.border_color="$COLOR_TEXT" \
  --subscribe memory system_woke mouse.entered mouse.exited mouse.exited.global

for row in swap pressure; do
  sketchybar --add item "memory.$row" popup.memory \
    --set "memory.$row" \
    icon.drawing=off \
    label.font="$FONT_SMALL" \
    label.align=left \
    width=220 \
    background.drawing=off
done

##### Network #####

sketchybar --add item network right \
  --set network \
  icon.width=20 \
  icon.align=center \
  icon.font="$FONT_LABEL" \
  label.width=230 \
  label.align=right \
  update_freq="$NETWORK_INTERVAL" \
  icon=󰛳 \
  script="$PLUGIN_DIR/network.sh" \
  --subscribe network system_woke

##### Force all scripts to run the first time (never do this in a script) #####

sketchybar --update
