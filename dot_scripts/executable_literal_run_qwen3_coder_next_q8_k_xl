#!/bin/bash

HOST_IP="${1:-127.0.0.1}"

echo "🚀 Starting llama-server on ${HOST_IP}..."

llama-server \
  --model "$MODEL_ROOT/Qwen3-Coder-Next-UD-Q8_K_XL/Qwen3-Coder-Next-UD-Q8_K_XL-00001-of-00003.gguf" \
  --alias qwen3-coder-next \
  --host "$HOST_IP" \
  --port 8080 \
  --ctx-size 262144 \
  --gpu-layers all \
  --batch-size 2048 \
  --ubatch-size 512 \
  --temp 1.0 \
  --top-p 0.95 \
  --top-k 40 \
  --min-p 0.01 \
  --repeat-penalty 1.00
