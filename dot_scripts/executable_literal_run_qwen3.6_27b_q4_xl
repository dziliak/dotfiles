#!/bin/bash

HOST_IP="${1:-127.0.0.1}"

echo "🚀 Starting llama-server on ${HOST_IP}..."

llama-server \
  --model "$MODEL_ROOT/Qwen3.6-27B-UD-Q4_K_XL/Qwen3.6-27B-UD-Q4_K_XL.gguf" \
  --alias qwen3.6-27b \
  --host "$HOST_IP" \
  --port 8080 \
  --ctx-size 32768 \
  --flash-attn on \
  --gpu-layers all \
  --batch-size 2048 \
  --ubatch-size 512 \
  --temp 1.00 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.00 \
  --repeat-penalty 1.5 \
  --presence-penalty 0.0
