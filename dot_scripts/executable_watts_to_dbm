#!/usr/bin/env lua

-- Convert watts to dBm:
-- dBm = 10 * log10(watts * 1000)

local function usage()
    io.stderr:write(
        string.format("Usage: %s <watts>\n", arg[0] or "watts_to_dbm")
    )
end

if #arg ~= 1 then
    usage()
    os.exit(1)
end

local watts = tonumber(arg[1])

if watts == nil or watts <= 0 then
    io.stderr:write("Error: watts must be a positive number.\n")
    os.exit(1)
end

local dbm = 10 * (math.log(watts * 1000) / math.log(10))

print(string.format("%.9g W = %.3f dBm", watts, dbm))
